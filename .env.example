# Public URL Ghost uses to generate links (must match how you access the site)
URL=http://localhost:2368

# Host port mapped to Ghost's container port 2368
PORT=2368

# Owner display name and site title (created once on first boot)
GHOST_ADMIN_NAME=Admin
GHOST_SITE_TITLE=Kono Gaijin

# YouTube channel for the home-page video strip (public ID, not a secret).
# Sample: @vaantako → UCV3h2_srSVaiEmjrZ8v7Qsw
# YOUTUBE_CHANNEL_ID=UCV3h2_srSVaiEmjrZ8v7Qsw
# YOUTUBE_REFRESH_MS=3600000

# Optional: transactional email (not required for initial admin setup)
# mail__transport=SMTP
# mail__options__host=smtp.example.com
# mail__options__port=587
# mail__options__secure=false
# mail__from=noreply@example.com
