# Owner staff account (created once on first boot; later changes are ignored)
GHOST_ADMIN_EMAIL=admin@example.com
GHOST_ADMIN_PASSWORD=change-me-now-please

# Shared secret for Ghost -> content-api webhook HMAC verification
# Bootstrap creates/updates all post/page webhooks with this secret on every boot.
CONTENT_API_WEBHOOK_SECRET=change-me-webhook-secret

# Optional: override Ghost webhook target (defaults to content-api on the compose network)
# CONTENT_API_WEBHOOK_TARGET_URL=http://content-api:8080/webhooks/ghost

# Optional: SMTP credentials
# mail__options__auth__user=
# mail__options__auth__pass=
