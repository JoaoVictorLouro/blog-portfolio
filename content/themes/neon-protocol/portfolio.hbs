{{!< default}}

<main class="np-main is-wide">
    <header class="np-about-banner">
        <h1 class="np-display">PORTFOLIO</h1>
        <p class="np-meta">{{#if @site.description}}{{@site.description}}{{else}}Encrypted visual logs. Access level: Alpha.{{/if}}</p>
    </header>
    <div class="np-filters">
        <button class="np-btn np-btn-ghost is-active" type="button" data-np-filter="all">ALL</button>
        {{#get "tags" limit="12" include="count.posts" filter="visibility:public" as |archive_tags|}}
            {{#foreach archive_tags}}
                <button class="np-chip" type="button" data-np-filter="{{slug}}">{{name}}</button>
            {{/foreach}}
        {{/get}}
    </div>

    <div class="np-masonry">
        {{#foreach posts}}
            {{> "masonry-item"}}
        {{else}}
            <p class="np-empty np-meta">{{t "No posts"}}</p>
        {{/foreach}}
    </div>

    {{pagination}}
</main>
