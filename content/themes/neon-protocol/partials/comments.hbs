{{#if comments}}
<section class="np-bbs" aria-label="{{t "Comments"}}">
    <div class="np-bbs-frame">
        <div class="np-bbs-bar">
            <span><span class="material-symbols-outlined">terminal</span>bbs_connection established</span>
            <span>ENC: AES-256</span>
        </div>
        <div class="np-bbs-body np-bbs-body--comments">
            {{comments title="" count=false mode="dark"}}
            <script>
                (function () {
                    try {
                        var mode =
                            document.documentElement.getAttribute('data-theme') === 'light'
                                ? 'light'
                                : 'dark';
                        var embed = document.currentScript.previousElementSibling;
                        if (embed && embed.dataset) {
                            embed.dataset.colorScheme = mode;
                        }
                    } catch (e) {}
                })();
            </script>
        </div>
    </div>
</section>
{{/if}}
