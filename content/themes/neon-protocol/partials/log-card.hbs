<article class="np-glass np-card {{post_class}}">
    <div class="np-card-stripe {{#if @odd}}{{else}}is-magenta{{/if}}"></div>
    {{#if feature_image}}
        <div class="np-card-media">
            <a href="{{url}}">
                <img src="{{img_url feature_image size="m"}}"
                    srcset="{{img_url feature_image size="s"}} 320w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 960w"
                    sizes="(min-width: 768px) 30vw, 100vw"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="lazy">
            </a>
        </div>
    {{/if}}
    <div class="np-label" style="color: var(--np-neon-teal);">
        <span class="material-symbols-outlined">schedule</span>
        <time datetime="{{date format="YYYY-MM-DD"}}">TS: {{date format="YYYY.MM.DD // HH:mm"}}</time>
    </div>
    <h3 class="np-heading"><a href="{{url}}">{{title}}</a></h3>
    {{#if excerpt}}<p>{{excerpt words="28"}}</p>{{/if}}
    <div class="np-card-tags">
        {{#foreach tags}}
            <span class="np-chip">#{{slug}}</span>
        {{/foreach}}
    </div>
</article>
