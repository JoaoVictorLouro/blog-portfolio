<hr class="np-home-work-rule" aria-hidden="true">

<header class="np-about-banner np-about-banner--row np-home-work-banner">
    <div>
        <h2 class="np-title" style="color: var(--np-secondary-container);"><span class="np-page-title"><span class="material-symbols-outlined" aria-hidden="true">engineering</span>{{> "np-t" key="ABOUT_MY_WORK_TITLE"}}</span></h2>
        <p class="np-meta">{{> "np-t" key="ABOUT_MY_WORK_SUBTITLE"}}</p>
    </div>
    <div class="np-live"><i class="np-fx-layer"></i><span class="np-label">{{> "np-t" key="ABOUT_MY_WORK_LIVE"}}</span></div>
</header>

<div class="np-home-work">
    <div class="np-home-work-lead np-led-display-group np-glass">
        <div class="np-led-display-bar">
            <span class="np-label">{{> "np-t" key="WORK_LEAD_LED_LABEL"}}</span>
            <span class="np-live"><i class="np-fx-layer"></i><span class="np-label">{{> "np-t" key="WORK_LEAD_LED_STATUS"}}</span></span>
        </div>
        <div class="np-led-display-grid">
            <div class="np-led-display-unit" data-np-led-counter data-np-led-target="10">
                <div class="np-led-display-panel">
                    <div class="np-led-scan np-fx-layer" aria-hidden="true"></div>
                    <div class="np-led-counter-row">
                        <span class="np-led-digit-cell"><span class="np-led-digit" data-np-led-digit>0</span></span>
                        <span class="np-led-digit-cell"><span class="np-led-digit" data-np-led-digit>0</span></span>
                        <span class="np-led-suffix" aria-hidden="true">+</span>
                    </div>
                    <p class="np-led-message"><span class="np-led-message-text">{{> "np-t" key="WORK_LEAD_HEADLINE_REST"}}</span></p>
                </div>
                <span class="np-sr-only">{{> "np-t" key="WORK_LEAD_HEADLINE"}}</span>
            </div>
            <div class="np-led-display-unit" data-np-led-counter data-np-led-target="40">
                <div class="np-led-display-panel">
                    <div class="np-led-scan np-fx-layer" aria-hidden="true"></div>
                    <div class="np-led-counter-row">
                        <span class="np-led-digit-cell"><span class="np-led-digit" data-np-led-digit>0</span></span>
                        <span class="np-led-digit-cell"><span class="np-led-digit" data-np-led-digit>0</span></span>
                        <span class="np-led-suffix" aria-hidden="true">+</span>
                    </div>
                    <p class="np-led-message"><span class="np-led-message-text">{{> "np-t" key="WORK_PROJECTS_HEADLINE_REST"}}</span></p>
                </div>
                <span class="np-sr-only">{{> "np-t" key="WORK_PROJECTS_HEADLINE"}}</span>
            </div>
        </div>
        <p class="np-led-subline np-label">{{> "np-t" key="WORK_LEAD_SUBLINE"}}</p>
    </div>

    <section class="np-home-work-block">
        <header class="np-about-banner np-about-banner--row np-home-work-section-banner">
            <div>
                <h3 class="np-title" style="color: var(--np-secondary-container);"><span class="np-page-title"><span class="material-symbols-outlined" aria-hidden="true">hub</span>{{> "np-t" key="WORK_STACKS_TITLE"}}</span></h3>
                <p class="np-meta">{{> "np-t" key="WORK_STACKS_SUBTITLE"}}</p>
            </div>
            <div class="np-live"><i class="np-fx-layer"></i><span class="np-label">{{> "np-t" key="WORK_STACKS_LIVE"}}</span></div>
        </header>
        <div class="np-work-stacks">
            <article class="np-glass np-card np-work-stack" data-np-tilt style="border-left: 2px solid var(--np-neon-teal);">
                <h4 class="np-label"><span class="material-symbols-outlined" aria-hidden="true">web</span>{{> "np-t" key="WORK_STACK_FRONTEND"}}</h4>
                <div class="np-work-chips">
                    <span class="np-chip">React</span>
                    <span class="np-chip">Svelte</span>
                    <span class="np-chip">Vue</span>
                    <span class="np-chip">Astro</span>
                    <span class="np-chip">Angular</span>
                    <span class="np-chip">Vanilla</span>
                </div>
            </article>
            <article class="np-glass np-card np-work-stack" data-np-tilt style="border-left: 2px solid var(--np-lantern-amber);">
                <h4 class="np-label"><span class="material-symbols-outlined" aria-hidden="true">memory</span>{{> "np-t" key="WORK_STACK_BACKEND"}}</h4>
                <div class="np-work-chips">
                    <span class="np-chip">Node.js</span>
                    <span class="np-chip">Python</span>
                    <span class="np-chip">Rust</span>
                    <span class="np-chip">Java</span>
                </div>
            </article>
            <article class="np-glass np-card np-work-stack" data-np-tilt style="border-left: 2px solid var(--np-cyber-magenta);">
                <h4 class="np-label"><span class="material-symbols-outlined" aria-hidden="true">cloud</span>{{> "np-t" key="WORK_STACK_CLOUD"}}</h4>
                <div class="np-work-chips">
                    <span class="np-chip">AWS</span>
                    <span class="np-chip">Azure</span>
                    <span class="np-chip">Google Cloud</span>
                    <span class="np-chip">Oracle Cloud</span>
                    <span class="np-chip">Hetzner</span>
                </div>
            </article>
            <article class="np-glass np-card np-work-stack" data-np-tilt style="border-left: 2px solid var(--np-neon-teal);">
                <h4 class="np-label"><span class="material-symbols-outlined" aria-hidden="true">deployed_code</span>{{> "np-t" key="WORK_STACK_VIRT"}}</h4>
                <div class="np-work-chips">
                    <span class="np-chip">Docker</span>
                    <span class="np-chip">Kubernetes</span>
                    <span class="np-chip">K3s</span>
                    <span class="np-chip">k3d</span>
                    <span class="np-chip">EKS</span>
                </div>
            </article>
            <article class="np-glass np-card np-work-stack" data-np-tilt style="border-left: 2px solid var(--np-lantern-amber);">
                <h4 class="np-label"><span class="material-symbols-outlined" aria-hidden="true">build</span>{{> "np-t" key="WORK_STACK_DEVOPS"}}</h4>
                <div class="np-work-chips">
                    <span class="np-chip">GitHub Actions</span>
                    <span class="np-chip">Jenkins</span>
                    <span class="np-chip">Travis CI</span>
                    <span class="np-chip">BuildKite</span>
                    <span class="np-chip">Forgejo</span>
                    <span class="np-chip">Gitea</span>
                </div>
            </article>
            <article class="np-glass np-card np-work-stack" data-np-tilt style="border-left: 2px solid var(--np-cyber-magenta);">
                <h4 class="np-label"><span class="material-symbols-outlined" aria-hidden="true">psychology</span>{{> "np-t" key="WORK_STACK_AI"}}</h4>
                <div class="np-work-chips">
                    <span class="np-chip">OpenAI</span>
                    <span class="np-chip">Claude</span>
                    <span class="np-chip">Google Gen-AI</span>
                    <span class="np-chip">OpenRouter</span>
                    <span class="np-chip">LangChain</span>
                    <span class="np-chip">RAG</span>
                    <span class="np-chip">LangGraph</span>
                    <span class="np-chip">LangSmith</span>
                    <span class="np-chip">ComfyUI</span>
                    <span class="np-chip">Custom Harnesses</span>
                </div>
            </article>
        </div>
    </section>

    <section class="np-home-work-block">
        <header class="np-about-banner np-about-banner--row np-home-work-section-banner">
            <div>
                <h3 class="np-title" style="color: var(--np-secondary-container);"><span class="np-page-title"><span class="material-symbols-outlined" aria-hidden="true">verified</span>{{> "np-t" key="WORK_CERTS_TITLE"}}</span></h3>
                <p class="np-meta">{{> "np-t" key="WORK_CERTS_SUBTITLE"}}</p>
            </div>
            <div class="np-live"><i class="np-fx-layer"></i><span class="np-label">{{> "np-t" key="WORK_CERTS_LIVE"}}</span></div>
        </header>
        <div class="np-work-certs">
            <article class="np-glass np-card np-work-cert" data-np-tilt>
                <span class="material-symbols-outlined np-work-cert-icon" aria-hidden="true">verified</span>
                <h4 class="np-heading">{{> "np-t" key="WORK_CERT_GOOGLE_TITLE"}}</h4>
                <p class="np-body">{{> "np-t" key="WORK_CERT_GOOGLE_DESC"}}</p>
            </article>
            <article class="np-glass np-card np-work-cert" data-np-tilt>
                <span class="material-symbols-outlined np-work-cert-icon" aria-hidden="true">verified</span>
                <h4 class="np-heading">{{> "np-t" key="WORK_CERT_IBM_TITLE"}}</h4>
                <p class="np-body">{{> "np-t" key="WORK_CERT_IBM_DESC"}}</p>
            </article>
            <article class="np-glass np-card np-work-cert" data-np-tilt>
                <span class="material-symbols-outlined np-work-cert-icon" aria-hidden="true">verified</span>
                <h4 class="np-heading">{{> "np-t" key="WORK_CERT_SCRUM_TITLE"}}</h4>
                <p class="np-body">{{> "np-t" key="WORK_CERT_SCRUM_DESC"}}</p>
            </article>
            <article class="np-glass np-card np-work-cert" data-np-tilt>
                <span class="material-symbols-outlined np-work-cert-icon" aria-hidden="true">school</span>
                <h4 class="np-heading">{{> "np-t" key="WORK_CERT_DEGREE_TITLE"}}</h4>
                <p class="np-body">{{> "np-t" key="WORK_CERT_DEGREE_DESC"}}</p>
            </article>
        </div>
    </section>

    <section class="np-home-work-block">
        <header class="np-about-banner np-about-banner--row np-home-work-section-banner">
            <div>
                <h3 class="np-title" style="color: var(--np-secondary-container);"><span class="np-page-title"><span class="material-symbols-outlined" aria-hidden="true">support_agent</span>{{> "np-t" key="WORK_VALUE_TITLE"}}</span></h3>
                <p class="np-meta">{{> "np-t" key="WORK_VALUE_SUBTITLE"}}</p>
            </div>
            <div class="np-live"><i class="np-fx-layer"></i><span class="np-label">{{> "np-t" key="WORK_VALUE_LIVE"}}</span></div>
        </header>
        <div class="np-work-values">
            <article class="np-glass np-card np-work-value" data-np-tilt style="border-left: 4px solid var(--np-neon-teal);">
                <h4 class="np-heading"><span class="material-symbols-outlined" aria-hidden="true">payments</span>{{> "np-t" key="WORK_VALUE_PAYMENT_TITLE"}}</h4>
                <p class="np-body">{{> "np-t" key="WORK_VALUE_PAYMENT_DESC"}}</p>
            </article>
            <article class="np-glass np-card np-work-value" data-np-tilt style="border-left: 4px solid var(--np-lantern-amber);">
                <h4 class="np-heading"><span class="material-symbols-outlined" aria-hidden="true">account_balance</span>{{> "np-t" key="WORK_VALUE_ACCOUNTING_TITLE"}}</h4>
                <p class="np-body">{{> "np-t" key="WORK_VALUE_ACCOUNTING_DESC"}}</p>
            </article>
            <article class="np-glass np-card np-work-value" data-np-tilt style="border-left: 4px solid var(--np-cyber-magenta);">
                <h4 class="np-heading"><span class="material-symbols-outlined" aria-hidden="true">timeline</span>{{> "np-t" key="WORK_VALUE_PROGRESS_TITLE"}}</h4>
                <p class="np-body">{{> "np-t" key="WORK_VALUE_PROGRESS_DESC"}}</p>
            </article>
            <article class="np-glass np-card np-work-value" data-np-tilt style="border-left: 4px solid var(--np-neon-teal);">
                <h4 class="np-heading"><span class="material-symbols-outlined" aria-hidden="true">support_agent</span>{{> "np-t" key="WORK_VALUE_SUPPORT_TITLE"}}</h4>
                <p class="np-body">{{> "np-t" key="WORK_VALUE_SUPPORT_DESC"}}</p>
            </article>
        </div>
    </section>

    <footer class="np-home-work-cta">
        <a class="np-btn np-btn-primary" href="{{@site.url}}/{{block "np_lang"}}/about/">
            {{> "np-t" key="ESTABLISH_CONNECTION"}}<span class="material-symbols-outlined" aria-hidden="true">send</span>
        </a>
    </footer>
</div>
