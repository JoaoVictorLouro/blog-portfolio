{{> "np-articles-feed"}}
{{#unless posts}}
    <p class="np-empty np-meta" data-np-i18n="No posts">{{> "np-t" key="No posts"}}</p>
{{/unless}}
{{#with meta.pagination}}
    {{#if next}}
        <nav class="np-pagination np-more" aria-label="{{t "Page {page} of {pages}" page=page pages=pages}}">
            <a class="np-btn np-btn-primary" href="{{#is "paged"}}../{{next}}/{{else}}page/{{next}}/{{/is}}">
                <span class="material-symbols-outlined" aria-hidden="true">download</span><span data-np-i18n="Load more">{{> "np-t" key="Load more"}}</span>
            </a>
            {{#if prev}}
                {{#match prev "=" 1}}
                    <a class="np-btn np-btn-ghost" href="{{#is "paged"}}../../{{else}}./{{/is}}" data-np-i18n="Newer posts">{{> "np-t" key="Newer posts"}}</a>
                {{else}}
                    <a class="np-btn np-btn-ghost" href="{{#is "paged"}}../{{prev}}/{{else}}page/{{prev}}/{{/is}}" data-np-i18n="Newer posts">{{> "np-t" key="Newer posts"}}</a>
                {{/match}}
            {{/if}}
        </nav>
    {{else}}
        {{#if prev}}
            <nav class="np-pagination np-more" aria-label="{{t "Page {page} of {pages}" page=page pages=pages}}">
                {{#match prev "=" 1}}
                    <a class="np-btn np-btn-ghost" href="{{#is "paged"}}../../{{else}}./{{/is}}" data-np-i18n="Newer posts">{{> "np-t" key="Newer posts"}}</a>
                {{else}}
                    <a class="np-btn np-btn-ghost" href="{{#is "paged"}}../{{prev}}/{{else}}page/{{prev}}/{{/is}}" data-np-i18n="Newer posts">{{> "np-t" key="Newer posts"}}</a>
                {{/match}}
            </nav>
        {{/if}}
    {{/if}}
{{/with}}
