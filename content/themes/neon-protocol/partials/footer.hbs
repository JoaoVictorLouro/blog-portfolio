<footer class="np-footer">
    <div class="np-footer-copy">© {{date format="YYYY"}} {{@site.title}} // {{t "ALL RIGHTS RESERVED"}}</div>
    <ul class="np-footer-links">
        {{#foreach navigation from="secondary"}}
            <li><a href="{{url}}">{{label}}</a></li>
        {{else}}
            <li><a href="{{@site.url}}/rss/">{{t "ENCRYPTION_LOG"}}</a></li>
            <li><a href="{{@site.url}}/articles/">{{t "SYSTEM_STATUS"}}</a></li>
            <li><a href="{{@site.url}}/portfolio/">{{t "DATA_MAP"}}</a></li>
        {{/foreach}}
    </ul>
</footer>
