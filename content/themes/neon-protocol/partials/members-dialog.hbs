{{#if @site.members_enabled}}
<dialog class="np-members" id="np-members" aria-labelledby="np-members-title" data-np-members-dialog>
    <div class="np-members-backdrop" data-np-members-close tabindex="-1"></div>
    <div class="np-members-panel np-glass" role="document">
        <span class="np-members-bracket np-members-bracket--tl" aria-hidden="true"></span>
        <span class="np-members-bracket np-members-bracket--tr" aria-hidden="true"></span>
        <span class="np-members-bracket np-members-bracket--bl" aria-hidden="true"></span>
        <span class="np-members-bracket np-members-bracket--br" aria-hidden="true"></span>

        <header class="np-members-head">
            <div class="np-members-head-text">
                <p class="np-meta np-members-kicker"><span class="material-symbols-outlined" aria-hidden="true">terminal</span>{{> "np-t" key="SECURE_CHANNEL"}}</p>
                <h2 class="np-heading" id="np-members-title">{{> "np-t" key="Subscribe"}}</h2>
            </div>
            <button class="np-icon-btn np-members-close" type="button" data-np-members-close aria-label="{{> "np-t" key="Close"}}">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </header>

        <div class="np-members-body">
            <section class="np-members-view" data-np-members-panel="subscribe" data-np-members-title="{{> "np-t" key="Subscribe"}}" hidden>
                <p class="np-body np-members-lead">{{> "np-t" key="Receive encrypted drops directly to your local node."}}</p>
                <form class="np-form np-members-form" data-members-form="subscribe">
                    <label class="np-label">{{> "np-t" key="Comm_Link_ID [Email]"}}
                        <input class="np-field" data-members-email type="email" required autocomplete="email" placeholder="{{> "np-t" key="ENTER_ADDRESS"}}" aria-label="{{> "np-t" key="Subscribe"}}">
                    </label>
                    <button class="np-btn np-btn-primary" type="submit">
                        {{> "np-t" key="OPEN_CHANNEL"}}<span class="material-symbols-outlined" aria-hidden="true">bolt</span>
                    </button>
                    <p class="np-members-status np-members-status--loading">{{> "np-t" key="TRANSMITTING..."}}</p>
                    <p class="np-members-status np-members-status--success">{{> "np-t" key="CHANNEL_OPEN // CHECK_COMM_LINK"}}</p>
                    <p class="np-members-status np-members-status--error" data-members-error></p>
                </form>
                <p class="np-meta np-members-switch">
                    {{> "np-t" key="ALREADY_LINKED?"}}
                    <button class="np-members-link" type="button" data-np-members="signin">{{> "np-t" key="AUTHENTICATE"}}</button>
                </p>
            </section>

            <section class="np-members-view" data-np-members-panel="signin" data-np-members-title="{{> "np-t" key="AUTHENTICATE_NODE"}}" hidden>
                <p class="np-body np-members-lead">{{> "np-t" key="Request a one-time access token for this node."}}</p>
                <form class="np-form np-members-form" data-members-form="signin">
                    <label class="np-label">{{> "np-t" key="Comm_Link_ID [Email]"}}
                        <input class="np-field" data-members-email type="email" required autocomplete="email" placeholder="{{> "np-t" key="ENTER_ADDRESS"}}" aria-label="{{> "np-t" key="Sign in"}}">
                    </label>
                    <button class="np-btn np-btn-primary" type="submit">
                        {{> "np-t" key="REQUEST_TOKEN"}}<span class="material-symbols-outlined" aria-hidden="true">key</span>
                    </button>
                    <p class="np-members-status np-members-status--loading">{{> "np-t" key="TRANSMITTING..."}}</p>
                    <p class="np-members-status np-members-status--success">{{> "np-t" key="TOKEN_DISPATCHED_TO_COMM_LINK"}}</p>
                    <p class="np-members-status np-members-status--error" data-members-error></p>
                </form>
                <p class="np-meta np-members-switch">
                    {{> "np-t" key="NEW_NODE?"}}
                    <button class="np-members-link" type="button" data-np-members="subscribe">{{> "np-t" key="Subscribe"}}</button>
                </p>
            </section>

            {{#if @member}}
                <section class="np-members-view" data-np-members-panel="account" data-np-members-title="{{> "np-t" key="NODE_SESSION"}}" hidden>
                    <p class="np-chip is-live">{{> "np-t" key="STATUS: AUTHENTICATED"}}</p>
                    <p class="np-meta np-members-clearance">{{> "np-t" key="CLEARANCE"}} // {{> "np-t" key="FREE_FEED"}}</p>
                    <form class="np-form np-members-form" data-np-account-form>
                        <label class="np-label">{{> "np-t" key="HANDLE"}}
                            <input class="np-field" data-np-account-name type="text" autocomplete="name" value="{{@member.name}}" aria-label="{{> "np-t" key="HANDLE"}}">
                        </label>
                        <label class="np-label">{{> "np-t" key="COMM_LINK"}}
                            <input class="np-field" data-np-account-email type="email" required autocomplete="email" value="{{@member.email}}" aria-label="{{> "np-t" key="COMM_LINK"}}">
                        </label>
                        <fieldset class="np-members-fieldset">
                            <legend class="np-label">{{> "np-t" key="FEED_CHANNELS"}}</legend>
                            {{#get "newsletters" filter="status:active" limit="100"}}
                                {{#foreach newsletters}}
                                    <label class="np-check">
                                        <input type="checkbox" data-np-account-newsletter value="{{id}}"{{#foreach @member.newsletters}}{{#match id ../id}} checked{{/match}}{{/foreach}}>
                                        <span>{{name}}</span>
                                    </label>
                                {{else}}
                                    <p class="np-meta">{{> "np-t" key="NO_FEED_CHANNELS"}}</p>
                                {{/foreach}}
                            {{/get}}
                        </fieldset>
                        <label class="np-check">
                            <input type="checkbox" data-np-account-comments checked>
                            <span>{{> "np-t" key="BBS_ALERTS"}}</span>
                        </label>
                        <button class="np-btn np-btn-primary" type="submit">
                            {{> "np-t" key="COMMIT"}}<span class="material-symbols-outlined" aria-hidden="true">save</span>
                        </button>
                        <p class="np-members-status np-members-status--loading">{{> "np-t" key="TRANSMITTING..."}}</p>
                        <p class="np-members-status np-members-status--success" data-np-account-success>{{> "np-t" key="NODE_SYNC_SAVED"}}</p>
                        <p class="np-members-status np-members-status--success" data-np-account-success-email hidden>{{> "np-t" key="COMM_LINK_CONFIRM"}}</p>
                        <p class="np-members-status np-members-status--error" data-members-error></p>
                    </form>
                    <div class="np-members-account-actions">
                        <button class="np-btn np-btn-ghost" type="button" data-members-signout>
                            {{> "np-t" key="DISCONNECT"}}<span class="material-symbols-outlined" aria-hidden="true">logout</span>
                        </button>
                        <button class="np-btn np-btn-danger" type="button" data-np-account-delete>
                            {{> "np-t" key="PURGE_NODE"}}<span class="material-symbols-outlined" aria-hidden="true">delete</span>
                        </button>
                    </div>
                    <div class="np-members-purge" data-np-account-delete-panel hidden>
                        <p class="np-body np-members-lead">{{> "np-t" key="PURGE_NODE_CONFIRM"}}</p>
                        <div class="np-members-account-actions">
                            <button class="np-btn np-btn-danger" type="button" data-np-account-delete-confirm>
                                {{> "np-t" key="PURGE_NODE_CONFIRM_ACTION"}}<span class="material-symbols-outlined" aria-hidden="true">warning</span>
                            </button>
                            <button class="np-btn np-btn-ghost" type="button" data-np-account-delete-cancel>
                                {{> "np-t" key="ABORT"}}
                            </button>
                        </div>
                    </div>
                </section>
            {{/if}}
        </div>
    </div>
</dialog>
{{/if}}
