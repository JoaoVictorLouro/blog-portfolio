<aside
    class="np-translation-switcher np-glass"
    data-np-translation-switcher
    data-np-post-url="{{url absolute="true"}}"
    hidden
>
    <h2 class="np-meta np-translation-switcher-title">
        <span class="material-symbols-outlined" aria-hidden="true">translate</span>
        {{> "np-post-label" key="READ_IN_ANOTHER_LANGUAGE"}}
    </h2>
    <ul class="np-translation-switcher-links" data-np-translation-links></ul>
    <p class="np-meta np-translation-switcher-empty" data-np-translation-empty hidden>{{> "np-post-label" key="NO_TRANSLATIONS"}}</p>
</aside>
