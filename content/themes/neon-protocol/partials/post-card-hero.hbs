<article class="np-glass np-hero-log {{post_class}}" data-np-tilt>
    {{#if feature_image}}
        <a class="np-hero-log-media" href="{{url}}" style="background-image: url('{{img_url feature_image size="xxl"}}');" aria-hidden="true"></a>
    {{/if}}
    <div class="np-hero-log-body">
        <div class="np-card-tags">
            {{#if primary_tag}}<span class="np-chip is-signal">{{primary_tag.name}}</span>{{/if}}
            <span class="np-chip">{{date format="YY.MM"}}</span>
        </div>
        <h1 class="np-title"><a href="{{url}}">{{title}}</a></h1>
        {{#if excerpt}}<p>{{excerpt words="32"}}</p>{{/if}}
        <div class="np-card-tags">
            <span class="np-label"><span class="material-symbols-outlined">schedule</span> {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
        </div>
    </div>
</article>
