<div class="np-share" aria-label="{{t "Share"}}">
    <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}" target="_blank" rel="noopener noreferrer" aria-label="X">
        <span class="material-symbols-outlined">share</span>
    </a>
    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute="true"}}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <span class="material-symbols-outlined">work</span>
    </a>
    <button type="button" data-np-copy="{{url absolute="true"}}" aria-label="{{t "Copy link"}}">
        <span class="material-symbols-outlined">link</span>
    </button>
</div>
