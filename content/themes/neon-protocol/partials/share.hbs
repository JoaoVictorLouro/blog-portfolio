    <a href="{{@site.url}}/{{> "np-locale-prefix-post"}}/articles/rss/" data-tooltip="{{t "RSS"}}" aria-label="{{t "RSS"}}">
        <span class="material-symbols-outlined" aria-hidden="true">rss_feed</span>
    </a>
    <a href="mailto:?subject={{encode title}}&body={{url absolute="true"}}" data-tooltip="{{t "Email"}}" aria-label="{{t "Email"}}">
        <span class="material-symbols-outlined" aria-hidden="true">mail</span>
    </a>
    <button
        type="button"
        data-np-copy="{{url absolute="true"}}"
        data-np-copied-label="{{t "Link copied"}}"
        data-tooltip="{{t "Copy link"}}"
        aria-label="{{t "Copy link"}}"
    >
        <span class="material-symbols-outlined" aria-hidden="true">link</span>
    </button>
</div>
