{{#post}}
    {{#match (block "np_translation_tag") ""}}
        <link rel="alternate" hreflang="{{#block "np_bcp47"}}en-US{{/block}}" href="{{url absolute="true"}}">
        <link rel="alternate" hreflang="x-default" href="{{url absolute="true"}}">
    {{else}}
        {{#foreach tags visibility="all"}}
            {{#match slug "~" "hash-translation-"}}
                {{#get "posts" filter="tag:{{slug}}" limit="all" include="tags"}}
                    {{#foreach posts}}
                        {{> "hreflang-post-link"}}
                    {{/foreach}}
                    {{#foreach posts}}
                        {{#has tag="#lang-ja-jp"}}
                        {{else has tag="#lang-pt-br"}}
                        {{else has tag="#lang-es-la"}}
                        {{else}}
                            <link rel="alternate" hreflang="x-default" href="{{url absolute="true"}}">
                        {{/has}}
                    {{/foreach}}
                {{/get}}
            {{/match}}
        {{/foreach}}
    {{/match}}
{{/post}}
