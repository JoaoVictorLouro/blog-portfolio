{{#match (block "np_hreflang_kind") "post"}}
    {{> "hreflang-post"}}
{{else match (block "np_hreflang_kind") "site"}}
    <link rel="alternate" hreflang="en-US" href="{{@site.url}}/en-us/{{#block "np_hreflang_suffix"}}{{/block}}">
    <link rel="alternate" hreflang="ja-JP" href="{{@site.url}}/ja-jp/{{#block "np_hreflang_suffix"}}{{/block}}">
    <link rel="alternate" hreflang="pt-BR" href="{{@site.url}}/pt-br/{{#block "np_hreflang_suffix"}}{{/block}}">
    <link rel="alternate" hreflang="es-419" href="{{@site.url}}/es-la/{{#block "np_hreflang_suffix"}}{{/block}}">
    <link rel="alternate" hreflang="x-default" href="{{@site.url}}/en-us/{{#block "np_hreflang_suffix"}}{{/block}}">
{{/match}}
