<a class="np-masonry-item" href="{{url}}" data-np-tags="{{#foreach tags}}{{slug}} {{/foreach}}">
    {{#if feature_image}}
        <img src="{{img_url feature_image size="l"}}"
            srcset="{{img_url feature_image size="s"}} 320w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 960w, {{img_url feature_image size="xl"}} 1200w"
            sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 100vw"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="lazy">
    {{else}}
        <div class="np-card" style="min-height: 16rem;">
            <span class="np-label">FILE: {{slug}}.DAT</span>
            <h3 class="np-heading">{{title}}</h3>
        </div>
    {{/if}}
    <div class="np-masonry-caption">
        <p class="np-label">FILE: {{slug}}.DAT</p>
        <p>{{title}}</p>
    </div>
    {{#if primary_tag}}
        <span class="np-chip is-magenta" style="position:absolute;top:1rem;right:1rem;">{{primary_tag.name}}</span>
    {{/if}}
</a>
