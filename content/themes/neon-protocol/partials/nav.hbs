<header class="np-nav" role="banner">
    <div id="np-data-stream" class="np-data-stream"></div>
    {{#is "post"}}
    {{#post}}
    <a class="np-brand" href="{{@site.url}}/{{> "np-locale-prefix-post"}}/">
        {{#if @site.logo}}
            <img src="{{@site.logo}}" alt="{{@site.title}}">
        {{else}}
            {{> "brand-title"}}
        {{/if}}
    </a>
    <nav class="np-nav-menu" aria-label="{{> "np-t" key="Menu"}}">
        {{> "np-nav-links-post"}}
    </nav>
    <div class="np-nav-actions">
        {{> "language-picker"}}
        <button class="np-icon-btn" type="button" data-np-theme-toggle aria-pressed="false" aria-label="{{> "np-t" key="Theme"}}">
            <span class="material-symbols-outlined" aria-hidden="true">sensors</span>
        </button>
        <button class="np-icon-btn" type="button" data-ghost-search aria-label="{{> "np-t" key="Search"}}">
            <span class="material-symbols-outlined" aria-hidden="true">terminal</span>
        </button>
    </div>
    {{/post}}
    {{else}}
    <a class="np-brand" href="{{@site.url}}/{{> "np-locale-prefix-site"}}/">
        {{#if @site.logo}}
            <img src="{{@site.logo}}" alt="{{@site.title}}">
        {{else}}
            {{> "brand-title"}}
        {{/if}}
    </a>
    <nav class="np-nav-menu" aria-label="{{> "np-t" key="Menu"}}">
        {{> "np-nav-links-site"}}
    </nav>
    <div class="np-nav-actions">
        {{> "language-picker"}}
        <button class="np-icon-btn" type="button" data-np-theme-toggle aria-pressed="false" aria-label="{{> "np-t" key="Theme"}}">
            <span class="material-symbols-outlined" aria-hidden="true">sensors</span>
        </button>
        <button class="np-icon-btn" type="button" data-ghost-search aria-label="{{> "np-t" key="Search"}}">
            <span class="material-symbols-outlined" aria-hidden="true">terminal</span>
        </button>
    </div>
    {{/is}}
</header>
