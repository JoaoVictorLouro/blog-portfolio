{{!< default}}

{{#post}}
<main class="np-main">
    <article class="np-article-wrap {{post_class}}">
        {{#match @page.show_title_and_feature_image}}
            <header class="np-about-banner">
                <h1 class="np-display">{{title}}</h1>
                {{#if custom_excerpt}}<p class="np-meta">{{custom_excerpt}}</p>{{/if}}
            </header>
            {{#if feature_image}}
                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
            {{/if}}
        {{/match}}
        <section class="np-prose">
            {{content}}
        </section>
    </article>
</main>
{{/post}}
