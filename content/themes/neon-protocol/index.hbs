{{!< default}}

<main class="np-main">
    <header class="np-about-banner">
        <h1 class="np-display"><span class="np-page-title"><span class="material-symbols-outlined" aria-hidden="true">database</span>{{> "np-t" key="ARTICLES_TITLE"}}</span></h1>
        <p class="np-meta">{{> "np-t" key="STATUS_ONLINE_ARCHIVE"}}</p>
    </header>

    <div class="np-toolbar">
        <div class="np-search">
            <span class="material-symbols-outlined" aria-hidden="true">search</span>
            <button type="button" data-ghost-search>{{> "np-t" key="Search"}}</button>
        </div>
        <div class="np-card-tags">
            <span class="np-chip is-live">{{> "np-t" key="STATUS_ONLINE"}}</span>
            <a class="np-btn np-btn-ghost" href="#posts">
                <span class="material-symbols-outlined">filter_list</span>{{> "np-t" key="FILTER"}}
            </a>
        </div>
    </div>

    <div id="posts">
        {{#foreach posts}}
            {{#if @first}}
                {{> "post-card-hero"}}
            {{/if}}
        {{/foreach}}

        <div class="np-bento">
            {{#foreach posts}}
                {{#unless @first}}
                    {{> "post-card" wide=@odd}}
                {{/unless}}
            {{/foreach}}
        </div>
    </div>

    {{#unless posts}}
        <p class="np-empty np-meta">{{> "np-t" key="No posts"}}</p>
    {{/unless}}

    {{pagination}}
</main>
