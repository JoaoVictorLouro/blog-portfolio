{{!< default}}

{{#if @site.cover_image}}
    {{#contentFor "head"}}
        <link rel="preload" as="image" href="{{img_url @site.cover_image size="xl"}}" fetchpriority="high">
    {{/contentFor}}
{{/if}}

<main class="np-main np-home">
    <section class="np-glass np-hero" data-np-tilt="subtle"{{#if @site.cover_image}} style="--np-hero-image: url('{{img_url @site.cover_image size="xl"}}');"{{/if}}>
        {{#if @site.cover_image}}
            <img class="np-hero-media np-fx-layer" src="{{img_url @site.cover_image size="xl"}}" fetchpriority="high" alt="" aria-hidden="true" decoding="async" width="1200" height="675">
            <div class="np-hero-shade np-fx-layer" aria-hidden="true"></div>
            {{> "cover-scan-overlay" line1="NODE_SYNC_COMPLETE" line2="BANDWIDTH: OPTIMAL" line3="AWAITING_TRANSMISSION..."}}
            <div class="np-glitch-effect np-fx-layer" aria-hidden="true"></div>
        {{/if}}
        <div class="np-hero-body">
            <div class="np-hero-kicker">
                <span class="np-chip is-live">{{> "np-t" key="SYSTEM_READY"}}</span>
                {{#if @custom.node_label}}
                    <span class="np-meta" style="color: var(--np-neon-teal);">Location: {{@custom.node_label}}</span>
                {{/if}}
            </div>
            <h1 class="np-display">{{> "brand-title"}}</h1>
            {{#if @site.description}}
                <p class="np-body">{{@site.description}}</p>
            {{/if}}
            {{#if @site.members_enabled}}
                {{#unless @member}}
                    <button class="np-btn np-btn-primary" type="button" data-np-members="subscribe" data-np-hero-cta>
                        {{> "np-t" key="INITIATE_SEQUENCE"}}<span class="material-symbols-outlined" aria-hidden="true">bolt</span>
                    </button>
                {{else}}
                    <a class="np-btn np-btn-primary" href="{{@site.url}}/{{block "np_lang"}}/articles/" data-np-hero-cta>
                        {{> "np-t" key="INITIATE_SEQUENCE"}}<span class="material-symbols-outlined" aria-hidden="true">bolt</span>
                    </a>
                {{/unless}}
            {{else}}
                <a class="np-btn np-btn-primary" href="{{@site.url}}/{{block "np_lang"}}/articles/" data-np-hero-cta>
                    {{> "np-t" key="INITIATE_SEQUENCE"}}<span class="material-symbols-outlined" aria-hidden="true">bolt</span>
                </a>
            {{/if}}
        </div>
    </section>

    <div class="np-home-layout">
        <section>
            <header class="np-about-banner np-about-banner--row">
                <div>
                    <h2 class="np-title" style="color: var(--np-secondary-container);"><span class="np-page-title"><span class="material-symbols-outlined" aria-hidden="true">cell_tower</span>{{> "np-t" key="RECENT_ARTICLES"}}</span></h2>
                    <p class="np-meta">{{> "np-t" key="LATEST_TRANSMISSIONS"}}</p>
                </div>
                <div class="np-live"><i class="np-fx-layer"></i><span class="np-label">{{> "np-t" key="LIVE_FEED"}}</span></div>
            </header>
            <div class="np-home-feed">
                {{#match (block "np_lang") "en-us"}}
                    {{#get "posts" filter="tag:-hash-lang-ja-jp+tag:-hash-lang-pt-br+tag:-hash-lang-es-la" include="tags,authors" limit="4" as |recent|}}
                        {{#foreach recent}}
                            {{> "log-card"}}
                        {{else}}
                            <p class="np-empty np-meta">{{> "np-t" key="No posts"}}</p>
                        {{/foreach}}
                    {{/get}}
                {{else match (block "np_lang") "ja-jp"}}
                    {{#get "posts" filter="tag:hash-lang-ja-jp" include="tags,authors" limit="4" as |recent|}}
                        {{#foreach recent}}
                            {{> "log-card"}}
                        {{else}}
                            <p class="np-empty np-meta">{{> "np-t" key="No posts"}}</p>
                        {{/foreach}}
                    {{/get}}
                {{else match (block "np_lang") "pt-br"}}
                    {{#get "posts" filter="tag:hash-lang-pt-br" include="tags,authors" limit="4" as |recent|}}
                        {{#foreach recent}}
                            {{> "log-card"}}
                        {{else}}
                            <p class="np-empty np-meta">{{> "np-t" key="No posts"}}</p>
                        {{/foreach}}
                    {{/get}}
                {{else match (block "np_lang") "es-la"}}
                    {{#get "posts" filter="tag:hash-lang-es-la" include="tags,authors" limit="4" as |recent|}}
                        {{#foreach recent}}
                            {{> "log-card"}}
                        {{else}}
                            <p class="np-empty np-meta">{{> "np-t" key="No posts"}}</p>
                        {{/foreach}}
                    {{/get}}
                {{else}}
                    {{#get "posts" filter="tag:-hash-lang-ja-jp+tag:-hash-lang-pt-br+tag:-hash-lang-es-la" include="tags,authors" limit="4" as |recent|}}
                        {{#foreach recent}}
                            {{> "log-card"}}
                        {{else}}
                            <p class="np-empty np-meta">{{> "np-t" key="No posts"}}</p>
                        {{/foreach}}
                    {{/get}}
                {{/match}}
            </div>

            <header class="np-about-banner np-about-banner--row np-youtube-banner">
                <div>
                    <h2 class="np-title" style="color: var(--np-secondary-container);"><span class="np-page-title"><span class="material-symbols-outlined" aria-hidden="true">play_circle</span>{{> "np-t" key="YOUTUBE_VIDEOS"}}</span></h2>
                    <p class="np-meta">{{> "np-t" key="YOUTUBE_SUBTITLE"}}</p>
                </div>
                <div class="np-live"><i class="np-fx-layer"></i><span class="np-label">{{> "np-t" key="YOUTUBE_LIVE"}}</span></div>
            </header>
            <div class="np-youtube-feed" data-np-youtube-feed hidden></div>

            {{> "home-about-work"}}
        </section>

        <aside class="np-sidebar">
            {{#if @custom.show_node_widget}}
                {{> "node-widget"}}
            {{/if}}
            {{> "subscribe"}}
        </aside>
    </div>
</main>
