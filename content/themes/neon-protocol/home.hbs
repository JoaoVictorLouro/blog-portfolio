{{!< default}}

{{#if @site.cover_image}}
    {{#contentFor "head"}}
        <link rel="preload" as="image" href="{{img_url @site.cover_image size="xl"}}" fetchpriority="high">
    {{/contentFor}}
{{/if}}

<main class="np-main np-home">
    <section class="np-glass np-hero" data-np-tilt="subtle"{{#if @site.cover_image}} style="--np-hero-image: url('{{img_url @site.cover_image size="xl"}}');"{{/if}}>
        {{#if @site.cover_image}}
            <img class="np-hero-media" src="{{img_url @site.cover_image size="xl"}}" fetchpriority="high" alt="" aria-hidden="true" decoding="async" width="1200" height="675">
            <div class="np-hero-shade" aria-hidden="true"></div>
            {{> "cover-scan-overlay" line1="NODE_SYNC_COMPLETE" line2="BANDWIDTH: OPTIMAL" line3="AWAITING_TRANSMISSION..."}}
            <div class="np-glitch-effect" aria-hidden="true"></div>
        {{/if}}
        <div class="np-hero-body">
            <div class="np-hero-kicker">
                <span class="np-chip is-live">SYSTEM.READY</span>
                {{#if @custom.node_label}}
                    <span class="np-meta" style="color: var(--np-neon-teal);">Location: {{@custom.node_label}}</span>
                {{/if}}
            </div>
            <h1 class="np-display">{{> "brand-title"}}</h1>
            {{#if @site.description}}
                <p class="np-body">{{@site.description}}</p>
            {{/if}}
            {{#if @site.members_enabled}}
                {{#unless @member}}
                    <button class="np-btn np-btn-primary" type="button" data-np-members="subscribe" data-np-hero-cta>
                        INITIATE_SEQUENCE<span class="material-symbols-outlined" aria-hidden="true">bolt</span>
                    </button>
                {{else}}
                    <a class="np-btn np-btn-primary" href="{{@site.url}}/articles/" data-np-hero-cta>
                        INITIATE_SEQUENCE<span class="material-symbols-outlined" aria-hidden="true">bolt</span>
                    </a>
                {{/unless}}
            {{else}}
                <a class="np-btn np-btn-primary" href="{{@site.url}}/articles/" data-np-hero-cta>
                    INITIATE_SEQUENCE<span class="material-symbols-outlined" aria-hidden="true">bolt</span>
                </a>
            {{/if}}
        </div>
    </section>

    <div class="np-home-layout">
        <section>
            <header class="np-about-banner np-about-banner--row">
                <div>
                    <h2 class="np-title" style="color: var(--np-secondary-container);"><span class="np-page-title"><span class="material-symbols-outlined" aria-hidden="true">cell_tower</span>RECENT_ARTICLES</span></h2>
                    <p class="np-meta">LATEST TRANSMISSIONS // FEED SYNC</p>
                </div>
                <div class="np-live"><i></i><span class="np-label">LIVE FEED</span></div>
            </header>
            <div class="np-home-feed">
                {{#get "posts" filter="tag:-hash-portfolio" include="tags,authors" limit="4" as |recent|}}
                    {{#foreach recent}}
                        {{> "log-card"}}
                    {{else}}
                        <p class="np-empty np-meta">{{t "No posts"}}</p>
                    {{/foreach}}
                {{/get}}
            </div>
        </section>

        <aside class="np-sidebar">
            {{#if @custom.show_node_widget}}
                {{> "node-widget"}}
            {{/if}}
            {{> "subscribe"}}
        </aside>
    </div>
</main>
