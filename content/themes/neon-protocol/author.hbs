{{!< default}}

<main class="np-main">
    {{#author}}
        <header class="np-about-banner">
            <h1 class="np-display">{{name}}</h1>
            {{#if bio}}<p class="np-body">{{bio}}</p>{{/if}}
        </header>
    {{/author}}

    <div class="np-bento">
        {{#foreach posts}}
            {{> "post-card" wide=@odd}}
        {{else}}
            <p class="np-empty np-meta">{{t "No posts"}}</p>
        {{/foreach}}
    </div>

    {{pagination}}
</main>
