{{!< default}}

{{#post}}
<main class="np-main">
    <header class="np-about-banner">
        <h1 class="np-display">{{title}}</h1>
        <p class="np-meta">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}STATUS: ONLINE // LOCATION: UNDEFINED{{/if}}</p>
    </header>

    <div class="np-about-grid">
        <article class="np-glass np-card np-about-bio" style="border-left: 2px solid var(--np-cyber-magenta);">
            <div class="np-section-head" style="margin-bottom: 1rem;">
                <h2 class="np-heading"><span class="material-symbols-outlined" style="color: var(--np-neon-teal);">account_circle</span> USER_PROFILE</h2>
            </div>
            <div class="np-prose">
                {{content}}
            </div>
            {{#if tags}}
                <div class="np-card-tags">
                    {{#foreach tags visibility="public"}}
                        <span class="np-chip">{{name}}</span>
                    {{/foreach}}
                </div>
            {{/if}}
        </article>

        <aside class="np-glass np-card np-about-photo">
            {{#if feature_image}}
                <div class="np-avatar">
                    <img src="{{img_url feature_image size="l"}}" alt="{{title}}">
                </div>
            {{else}}
                {{#foreach authors}}
                    {{#if profile_image}}
                        <div class="np-avatar">
                            <img src="{{img_url profile_image size="l"}}" alt="{{name}}">
                        </div>
                    {{/if}}
                {{/foreach}}
            {{/if}}
            <div class="np-kv">
                <span>ID: {{slug}}</span>
                <span class="np-label" style="color: var(--np-lantern-amber);">ENCRYPTED</span>
            </div>
        </aside>

        <section class="np-glass np-card np-about-form" data-np-tilt style="border-left: 4px solid var(--np-lantern-amber);">
            <div class="np-section-head" style="margin-bottom: 1rem;">
                <h2 class="np-heading" style="color: var(--np-secondary);"><span class="material-symbols-outlined" style="color: var(--np-lantern-amber);">mail</span> ESTABLISH_CONNECTION</h2>
            </div>
            {{#if @custom.contact_form_action}}
                <form class="np-form" action="{{@custom.contact_form_action}}" method="POST">
                    <label class="np-label">Comm_Link_ID [Email]
                        <input class="np-field" type="email" name="email" required placeholder="user@network.node">
                    </label>
                    <label class="np-label">Data_Payload [Message]
                        <textarea class="np-field" name="message" rows="4" required placeholder="Enter transmission..."></textarea>
                    </label>
                    <button class="np-btn np-btn-primary" type="submit">{{t "Transmit"}} <span class="material-symbols-outlined">send</span></button>
                </form>
            {{else}}
                <form class="np-form" data-np-mailto="{{@custom.contact_email}}" {{#unless @custom.contact_email}}onsubmit="return false;"{{/unless}}>
                    <label class="np-label">Comm_Link_ID [Email]
                        <input class="np-field" type="email" name="email" required placeholder="user@network.node">
                    </label>
                    <label class="np-label">Data_Payload [Message]
                        <textarea class="np-field" name="message" rows="4" required placeholder="Enter transmission..."></textarea>
                    </label>
                    <button class="np-btn np-btn-primary" type="submit">{{t "Transmit"}} <span class="material-symbols-outlined">send</span></button>
                </form>
            {{/if}}
        </section>

        <section class="np-glass np-card np-about-nodes" data-np-tilt>
            <div class="np-section-head" style="margin-bottom: 1rem;">
                <h2 class="np-heading" style="color: var(--np-tertiary-dim);"><span class="material-symbols-outlined" style="color: var(--np-cyber-magenta);">hub</span> NETWORK_NODES</h2>
            </div>
            <div class="np-nodes">
                {{#if @custom.github_url}}
                    <a class="np-node" href="{{@custom.github_url}}" target="_blank" rel="noopener noreferrer">
                        <span class="material-symbols-outlined">code</span> GitHub_Repo
                    </a>
                {{/if}}
                <a class="np-node" href="{{@site.url}}/articles/">
                    <span class="material-symbols-outlined">terminal</span> Articles
                </a>
                <a class="np-node" href="{{@site.url}}/portfolio/">
                    <span class="material-symbols-outlined">language</span> Portfolio
                </a>
                {{#if @custom.social_url}}
                    <a class="np-node" href="{{@custom.social_url}}" target="_blank" rel="noopener noreferrer">
                        <span class="material-symbols-outlined">share</span> Social_Net
                    </a>
                {{else}}
                    {{#if @site.facebook}}
                        <a class="np-node" href="https://www.facebook.com/{{@site.facebook}}" target="_blank" rel="noopener noreferrer">
                            <span class="material-symbols-outlined">share</span> Social_Net
                        </a>
                    {{/if}}
                {{/if}}
            </div>
        </section>
    </div>
</main>
{{/post}}
