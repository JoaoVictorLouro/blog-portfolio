<!DOCTYPE html>
<html lang="{{@site.locale}}" data-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{meta_title page=(t " (Page %)")}}</title>
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('np-theme');
                document.documentElement.setAttribute('data-theme', theme === 'light' ? 'light' : 'dark');
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
            try {
                if (sessionStorage.getItem('np-page-enter') === '1') {
                    document.documentElement.classList.add('np-page-entering');
                    sessionStorage.removeItem('np-page-enter');
                }
            } catch (e) {}
        })();
    </script>
    <link rel="preconnect" href="https://ows.terrestris.de">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500;700&family=Sora:wght@400;600;700;800&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0">
    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}">
    {{ghost_head}}
</head>
<body class="{{body_class}}">
<div class="np-shell">
    {{> "nav"}}
    {{{body}}}
    {{> "footer"}}
    {{> "nav-mobile"}}
    {{> "portal-trigger"}}
    <div class="np-page-glitch" id="np-page-glitch" aria-hidden="true"></div>
</div>
<script src="{{asset "js/theme.js"}}"></script>
{{ghost_foot}}
</body>
</html>
