{{!< default}}

{{#post}}
<main class="np-main is-flush">
    <header class="np-article-hero">
        {{#if feature_image}}
            <div class="np-article-hero-frame" style="background-image: url('{{img_url feature_image size="xxl"}}');"></div>
        {{else}}
            <div class="np-article-hero-frame"></div>
        {{/if}}
        <div class="np-article-hero-body">
            <div class="np-card-tags">
                {{#foreach tags visibility="public"}}
                    <span class="np-chip is-magenta">{{name}}</span>
                {{/foreach}}
            </div>
            <h1 class="np-display">{{title}}</h1>
            <div class="np-meta" style="border-left: 2px solid var(--np-neon-teal); padding-left: 1rem;">
                {{#foreach authors}}
                    <span>AUTHOR: <span style="color: var(--np-secondary-container);">{{name}}</span></span>
                {{/foreach}}
                <span> /// </span>
                <time datetime="{{date format="YYYY-MM-DD"}}">UPLOADED: {{date format="YYYY.MM.DD"}}</time>
            </div>
        </div>
    </header>

    <article class="np-article-wrap {{post_class}}">
        {{> "share"}}
        <section class="np-prose">
            {{content}}
        </section>
    </article>

    {{> "comments"}}
</main>
{{/post}}
