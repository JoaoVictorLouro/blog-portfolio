{{!< default}}

{{#post}}
    {{> "np-set-locale-from-tags"}}
    {{#if feature_image}}
        {{#contentFor "head"}}
            <link rel="preload" as="image" href="{{img_url feature_image size="xl"}}" fetchpriority="high">
        {{/contentFor}}
    {{/if}}
<main class="np-main is-flush">
    <header class="np-article-hero">
        <div class="np-article-hero-frame"{{#if feature_image}} style="--np-hero-image: url('{{img_url feature_image size="xl"}}');"{{/if}}>
            {{#if feature_image}}
                <img class="np-article-hero-media np-fx-layer" src="{{img_url feature_image size="xl"}}" fetchpriority="high" alt="" aria-hidden="true" decoding="async" width="1200" height="675">
            {{/if}}
            {{#if feature_image}}
                <div class="np-article-hero-shade np-fx-layer" aria-hidden="true"></div>
                {{> "cover-scan-overlay" line1="LOG_DECRYPTED" line2="STREAM_BUFFER_ACTIVE" line3="READING_PACKET_DATA..."}}
                <div class="np-glitch-effect np-fx-layer" aria-hidden="true"></div>
            {{/if}}
        </div>
        <div class="np-article-hero-body">
            <div class="np-article-hero-panel">
                <div class="np-card-tags">
                    {{#foreach tags visibility="public"}}
                        <span class="np-chip is-amber">{{name}}</span>
                    {{/foreach}}
                </div>
                <h1 class="np-display">{{title}}</h1>
                <div class="np-meta" style="border-left: 2px solid var(--np-neon-teal); padding-left: 1rem;">
                    <span>{{> "np-post-label" key="AUTHOR"}}:
                    {{#foreach authors}}
                        <span style="color: var(--np-secondary-container);">{{name}}</span>
                    {{/foreach}}
                    </span>
                    <span> /// </span>
                    <time datetime="{{date format="YYYY-MM-DD"}}">{{> "np-post-label" key="UPLOADED"}}: {{date format="YYYY.MM.DD"}}</time>
                </div>
            </div>
        </div>
    </header>

    <div class="np-article-share">
        {{> "share"}}
    </div>

    <div class="np-article-translations">
        {{> "translation-switcher"}}
    </div>

    <article class="np-article-wrap {{post_class}}">
        <section class="np-prose">
            {{content}}
        </section>
    </article>

    {{> "comments"}}
</main>
{{/post}}
