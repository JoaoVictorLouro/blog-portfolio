{
  "version": 1,
  "hooks": {
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/block-env-read.sh",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/format-edited-file.sh",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/verify-on-stop.sh",
        "timeout": 180,
        "loop_limit": 3
      }
    ]
  }
}
